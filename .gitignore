data/**/*.onnx
ml/**/*.onnx
!ml/learnsign/data/

# Reports raw scratch
reports/**/raw/

# Environment and secrets
.env
.env.*
*.local

# Editor directories
.vscode/
.idea/

# Internal planning notes (kept out of git tracking)
.notes/

# MediaPipe Task model files and ORT WASM runtime are downloaded/prepared at build time, not committed
web/public/models/
web/public/ort/
