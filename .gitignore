# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
*.egg-info/

# Tests & caches
.pytest_cache/
.ruff_cache/
coverage/

# Data and Models (never commit datasets or local weights)
/data/
ml/data/
*.parquet
*.npy
